# Copy to .env and fill in. NEVER commit the real .env
# ---------------------------------------------------------------
# Keys that callers of THIS api present, comma separated.
API_KEYS=

# The opaque handle callers pass as auth_id. Bound to the API keys above, so a
# caller cannot reference a handle that is not theirs.
AUTH_ID=b3f1c2e4-8a90-4d21-9f77-2ce1d0a4b512

# LinkedIn backend session.
# Chrome -> DevTools -> Application -> Cookies -> https://www.linkedin.com
#   li_at       : the session cookie (HttpOnly, so copy it from here)
#   JSESSIONID  : looks like "ajax:1234567890" - quotes are stripped for you
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional tuning
CACHE_TTL_SECONDS=21600
RATE_LIMIT_PER_MINUTE=30
