{
  "info": {
    "name": "LinkedIn Profile API",
    "description": "Accepts a LinkedIn profile URL and returns the profile as structured JSON, sourced from LinkedIn's internal Voyager API.\n\n## Setup (30 seconds)\n\n1. Open the collection's **Variables** tab\n2. Paste the API key you were given into `apiKey`\n3. Optionally change `profileUrl` to any LinkedIn profile\n4. Open **2 · Fetch profile** and hit **Send**\n\nEverything else is pre-filled. Each request carries assertions, so the **Test Results** tab tells you what passed.\n\n> The first request may take ~50s if the service has been idle — free hosting tier waking up. Everything after that is fast.\n\nRepo: https://github.com/vishant007/tross-assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://tross-assignment-ihro.onrender.com",
      "type": "string",
      "description": "The deployed service."
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "PASTE THE KEY YOU WERE GIVEN HERE. Deliberately empty in the repository — the project keeps credentials out of version control, and an API key is a credential."
    },
    {
      "key": "profileUrl",
      "value": "https://www.linkedin.com/in/thevishantshah/",
      "type": "string",
      "description": "CHANGE ME. Any LinkedIn profile URL form works, or a bare identifier."
    }
  ],
  "item": [
    {
      "name": "1 · Health check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness, plus whether the backend LinkedIn session is still usable. Needs no API key.\n\n`sessionValid: false` means the backend credential expired — an operator task, not your problem. Always returns 200 because the service itself is up either way."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('reports session state', () => pm.expect(b).to.have.property('sessionValid'));",
              "pm.test('backend session is alive', () => pm.expect(b.sessionValid, b.detail || '').to.be.true);",
              "pm.test('HSTS header present', () => pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Fetch profile  ← START HERE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"profileUrl\": \"{{profileUrl}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/integrations/linkedin/fetch-profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integrations",
            "linkedin",
            "fetch-profile"
          ]
        },
        "description": "The main operation. Returns name, headline, location, about, experience, education, skills, certifications, languages and profile images **when available**.\n\nSections the backend session cannot see appear in `warnings` rather than failing the request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "// The response is keyed by one domain noun, with no generic wrapper.",
              "pm.test('contract shape is exactly {profile, warnings, fetchedAt}', () => {",
              "  pm.expect(Object.keys(b).sort()).to.eql(['fetchedAt', 'profile', 'warnings']);",
              "});",
              "pm.test('no generic data wrapper', () => pm.expect(b).to.not.have.property('data'));",
              "",
              "pm.test('identity fields present', () => {",
              "  pm.expect(b.profile.publicIdentifier).to.be.a('string').and.not.empty;",
              "  pm.expect(b.profile).to.have.property('firstName');",
              "});",
              "pm.test('warnings is a list', () => pm.expect(b.warnings).to.be.an('array'));",
              "",
              "// Dates keep whatever precision LinkedIn gave: 2025, 2025-07 or 2025-07-14.",
              "pm.test('dates are not padded to fake precision', () => {",
              "  (b.profile.experience || []).forEach(e => {",
              "    if (e.dates && e.dates.start) pm.expect([4, 7, 10]).to.include(e.dates.start.length);",
              "  });",
              "});",
              "",
              "pm.test('no credential leaked into the response', () => {",
              "  pm.expect(pm.response.text()).to.not.include('li_at');",
              "  pm.expect(pm.response.text()).to.not.include('JSESSIONID');",
              "});",
              "",
              "console.log('Cache:', pm.response.headers.get('X-Cache'), '| requestId:', pm.response.headers.get('X-Request-Id'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Fetch profile — selected sections only",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"profileUrl\": \"{{profileUrl}}\",\n    \"sections\": [\"skills\", \"certifications\"]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/integrations/linkedin/fetch-profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integrations",
            "linkedin",
            "fetch-profile"
          ]
        },
        "description": "`sections` shapes the response. Valid values: experience, education, skills, certifications, languages.\n\nNote it does **not** reduce upstream cost — LinkedIn returns the whole profile in one call, which was measured rather than assumed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const p = pm.response.json().profile;",
              "pm.test('requested sections returned', () => pm.expect(p.skills).to.be.an('array'));",
              "pm.test('unrequested sections omitted', () => {",
              "  pm.expect(p.experience).to.eql([]);",
              "  pm.expect(p.education).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 · Fetch profile — GET alias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/integrations/linkedin/fetch-profile?profileUrl={{profileUrl}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integrations",
            "linkedin",
            "fetch-profile"
          ],
          "query": [
            {
              "key": "profileUrl",
              "value": "{{profileUrl}}"
            }
          ]
        },
        "description": "Same contract via GET. POST is the primary method — it matches the platform convention being mirrored, and keeps profile URLs out of access logs, browser history and Referer headers. This alias exists because GET is what people reach for first."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('identical contract to POST', () => {",
              "  pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['fetchedAt', 'profile', 'warnings']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 · Error — no API key (401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": { \"profileUrl\": \"{{profileUrl}}\" }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/integrations/linkedin/fetch-profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integrations",
            "linkedin",
            "fetch-profile"
          ]
        },
        "description": "Every failure — including request validation — uses one error envelope, so callers only ever parse one shape."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "const e = pm.response.json().error;",
              "pm.test('error envelope shape', () => {",
              "  pm.expect(Object.keys(e).sort()).to.eql(['code', 'message', 'requestId', 'retryable']);",
              "});",
              "pm.test('code is INVALID_API_KEY', () => pm.expect(e.code).to.eql('INVALID_API_KEY'));",
              "pm.test('retryable is explicit', () => pm.expect(e.retryable).to.be.a('boolean'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 · Error — not a LinkedIn URL (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": { \"profileUrl\": \"https://linkedin.com.evil.example/in/someone\" }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/integrations/linkedin/fetch-profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "integrations",
            "linkedin",
            "fetch-profile"
          ]
        },
        "description": "Input validation uses a host **allowlist**, so lookalike domains are rejected rather than filtered by pattern."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('code is INVALID_PROFILE_URL', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_PROFILE_URL'));"
            ]
          }
        }
      ]
    }
  ]
}
